{
  "name": "immxrsive-talent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration",
    "test:api": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration/talent-api.test.ts tests/integration/student-profile-api.test.ts tests/integration/project-detail-api.test.ts tests/integration/inquiry-api.test.ts tests/integration/auth-identity.test.ts tests/integration/affiliation-verification.test.ts tests/integration/private-student-profile.test.ts",
    "test:frontend": "vitest run tests/frontend",
    "test:browser": "npm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:migrate:test": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-test.ts",
    "fixtures:validate": "tsx scripts/validate-fixtures.ts",
    "fixtures:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-fixtures.ts",
    "fixtures:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-import.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.149.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
