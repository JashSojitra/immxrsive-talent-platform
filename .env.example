# Runtime connection used by the application and fixture importer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Direct PostgreSQL connection used by drizzle-kit for migrations.
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Dedicated disposable database for integration tests. Never point this at production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE

# Better Auth server configuration. Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App credentials. Never use a personal access token here.
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET

# Release 2 student affiliation verification.
ALGOMA_APPROVED_EMAIL_DOMAINS=algomau.ca
AFFILIATION_VERIFICATION_TTL_MINUTES=30
AFFILIATION_EMAIL_FROM=ImmXrsive <verify@YOUR_VERIFIED_SENDING_DOMAIN>
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
